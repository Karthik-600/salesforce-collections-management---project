<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Check_Loan_Closure_Eligibility</name>
        <label>Check Loan Closure Eligibility</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <actionName>LoanClosureService</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>loanIds</name>
            <value>
                <elementReference>$Record.Loan_Account__c</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <description>Record-Triggered Flow on Payment__c when Payment_Status__c becomes Success. Checks whether the parent Loan_Account__c qualifies for automated closure after PaymentTrigger recalculates balances.</description>
    <interviewLabel>Payment Processing Auto Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payment Processing Auto Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Loan_Closure_Eligibility</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Payment_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Success</stringValue>
            </value>
        </filters>
        <object>Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
